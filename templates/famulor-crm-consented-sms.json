              "name": "fromNumberId",
              "value": "",
              "type": "string"
            },
            {
              "id": "5e47f123-f14b-4cf3-a272-20580e24b53f",
              "name": "messageText",
              "value": "Thanks for contacting us. Our team will follow up shortly.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "c4110d4d-744e-4a24-a7e1-3d8a598b90bd",
      "name": "Check consent and normalize leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const seen=new Set();return $input.all().map(item=>{const c=item.json;const raw=c.body&&typeof c.body==='object'&&!Array.isArray(c.body)?c.body:c;const phone=typeof raw.phone==='string'?raw.phone.trim():'';const event=typeof raw.external_id==='string'?raw.external_id.trim():'';const text=typeof c.messageText==='string'?c.messageText.trim():'';const reasons=[];if(raw.consent_sms!==true)reasons.push('Explicit SMS consent is required');if(!/^\\+[1-9]\\d{7,14}$/.test(phone))reasons.push('E.164 phone is required');if(!event||event.length>120)reasons.push('A stable CRM event ID is required');if(seen.has(event))reasons.push('Duplicate event in this execution');if(!text||text.length>1600)reasons.push('Message must contain 1–1600 characters');seen.add(event);return {json:{external_id:event,to:phone,body:text,from_number_id:c.fromNumberId,eligible:reasons.length===0,reasons,previewOnly:c.previewOnly!==false||c.sampleInput===true}};});"
      }
    },
    {
      "id": "a4b62e3d-5e79-4469-a475-a3d24277d603",
      "name": "Eligible for SMS?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
