    {
      "id": "770f45c2-2cfb-4414-a172-786b07f3e5fa",
      "name": "Validate configured sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        340
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>{if(typeof item.json.from_number_id!=='string'||!/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(item.json.from_number_id))throw new Error('Select an outbound SMS-capable Famulor number before enabling writes.');return item;});"
      }
    },
    {
      "id": "f324276b-a6c6-469c-ac9c-93812647d85a",
      "name": "Send authorized SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        340
      ],
      "parameters": {
        "method": "POST",
        "url": "https://app.famulor.io/api/v1/sms/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from_number_id: $json.from_number_id, to: $json.to, body: $json.body } }}",
        "options": {
