    {
      "id": "b008681d-4823-4f14-a8bc-dffbe95880b6",
      "name": "Start here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -60
      ],
      "parameters": {
        "content": "## Consent-checked CRM SMS follow-up\nFor trusted CRM lead events with phone, external_id and boolean consent_sms. Validates the event and exposes rejected reasons. Preview is enabled. The manual example is permanently preview-only, even if writes are enabled later.",
        "width": 620,
        "height": 230,
        "color": 7
      }
    },
    {
      "id": "d04b1b3b-20ec-4846-aae1-ca23218a5c6f",
      "name": "Credentials and sender",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        650,
        -60
      ],
      "parameters": {
        "content": "## Setup\nConfigure Header Auth on the inbound webhook. Select a separate Famulor HTTP Header Auth credential with sms:send on the send node. Choose an existing outbound SMS-capable number UUID in Configure SMS. No sender or real recipient is bundled.",
        "width": 510,
        "height": 230,
        "color": 7
      }
    },
    {
      "id": "d2a5262d-c247-4950-ac91-40dbda43590b",
      "name": "Example payload",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        440,
        650
      ],
      "parameters": {
        "content": "## Expected trusted CRM payload\nUse synthetic records first. Example: external_id = example-event-1, phone = +15550100000, consent_sms = true (boolean). String \"true\" is rejected. Edit messageText in Configure SMS. The webhook acknowledgement is not proof of delivery.",
        "width": 510,
        "height": 230,
        "color": 7
      }
    },
    {
      "id": "a478a0f7-c8bb-4e67-a349-158b1d4431bb",
      "name": "Activation and repeats",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1160,
        650
      ],
      "parameters": {
        "content": "## Before enabling writes\nRun the exact export against an authorized test sender and recipient. SMS consumes Famulor credits. Source CRM must send each consented event once: duplicates are detected only within one execution, not across requests. An uncertain send must be inspected before retrying.",
        "width": 620,
        "height": 240,
        "color": 7
      }
    }
  ],
