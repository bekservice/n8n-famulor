    {
      "id": "1052df99-0e59-4d5d-a81e-77a7b7701fd6",
      "name": "Read Famulor assistant pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://app.famulor.io/api/v1/assistants",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "200"
            },
            {
              "name": "offset",
              "value": "0"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "offset",
                    "value": "={{ $pageCount * 200 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !Array.isArray($response.body?.data) || $response.body.data.length < 200 || (($pageCount + 1) * 200 >= $response.body?.meta?.pagination?.total) }}",
              "limitPagesFetched": true,
              "maxRequests": 10
            }
          },
          "timeout": 30000
        }
      },
      "notesInFlow": true,
      "notes": "Choose an HTTP Header Auth credential: Authorization = Bearer <workspace API key> (assistants:read). Verify the credential after import. Do not paste the key into this node."
    },
    {
      "id": "954ec2dc-0a1a-426c-a880-5f093d809049",
      "name": "Validate and prepare assistant rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "\nconst pages = $input.all().map(item => item.json);\nif (!pages.length) throw new Error('Famulor returned no response pages.');\nconst total = pages[0]?.meta?.pagination?.total;\nif (!Number.isSafeInteger(total) || total < 0) throw new Error('Missing or invalid Famulor pagination total.');\nif (total > 2000) throw new Error('More than 2,000 records. Narrow the workflow scope before running it.');\nlet offset = 0;\nconst records = [];\nfor (const page of pages) {\n  const meta = page?.meta?.pagination;\n  if (!Array.isArray(page?.data) || !meta || meta.total !== total || meta.offset !== offset || meta.limit !== 200) {\n    throw new Error('Incomplete or inconsistent Famulor pagination; no destination was changed.');\n  }\n  if (page.data.length > 200) throw new Error('Unexpected Famulor page size.');\n  records.push(...page.data);\n  offset += 200;\n}\nif (records.length !== total) throw new Error('The Famulor scan was incomplete or changed while paging; no destination was changed.');\nconst ids = records.map(record => record?.id);\nif (ids.some(value => typeof value !== 'string' || !value) || new Set(ids).size !== ids.length) {\n  throw new Error('Missing or duplicate record IDs; no destination was changed.');\n}\n\nconst seenAt = new Date().toISOString();\nconst rows = records.map(assistant => ({\n  'Assistant ID': assistant.id,\n  'Name': typeof assistant.name === 'string' ? assistant.name : '',\n  'Active': assistant.is_active === true ? 'Yes' : 'No',\n  'Mode': typeof assistant.mode === 'string' ? assistant.mode : '',\n  'Language': typeof assistant.stt_language === 'string' ? assistant.stt_language : '',\n  'Tags': Array.isArray(assistant.tags) ? assistant.tags.filter(x => typeof x === 'string').join(', ') : '',\n  'Created at': typeof assistant.created_at === 'string' ? assistant.created_at : '',\n  'Updated at': typeof assistant.updated_at === 'string' ? assistant.updated_at : '',\n  'Last seen': seenAt,\n}));\nreturn (rows.length ? rows : [{ _empty: true }]).map(row => ({ json: { ...row, hasRows: rows.length > 0, previewOnly: $('Configure inventory').first().json.previewOnly } }));\n"
      }
    },
